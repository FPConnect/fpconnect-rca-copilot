# Application
APP_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=postgresql://fpconnect:fpconnect_pass@db:5432/fpconnect
POSTGRES_USER=fpconnect
POSTGRES_PASSWORD=fpconnect_pass
POSTGRES_DB=fpconnect

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO / S3
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=fpconnect

# OpenAI
OPENAI_API_KEY=sk-placeholder-change-me

# API
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=FPConnect
NEXT_PUBLIC_APP_VERSION=1.0.0
