# Application
APP_ENV=development
SECRET_KEY=replace-with-a-random-secret-with-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=postgresql://fpconnect:fpconnect_pass@db:5432/fpconnect
POSTGRES_USER=fpconnect
POSTGRES_PASSWORD=fpconnect_pass
POSTGRES_DB=fpconnect

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO / S3
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=fpconnect

# OpenAI
OPENAI_API_KEY=sk-placeholder-change-me

# Intel/Radar (public sources)
# Path is relative to apps/api working dir in container (/app)
INTEL_SOURCES_PATH=app/intel/sources.yaml
INTEL_DEFAULT_LIMIT=50
INTEL_REQUIRE_AUTH=true
ALLOW_DEV_ANONYMOUS_ACCESS=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081

# API
NEXT_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_API_TOKEN=
NEXT_PUBLIC_APP_NAME=FPConnect
NEXT_PUBLIC_APP_VERSION=1.0.0

# ========== SENTRY (Error Tracking & APM) ==========
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# ========== OLLAMA (Local LLM for Intel Summarization) ==========
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral
USE_OLLAMA=true
USE_OPENAI=false

# ========== N8N INTEGRATION ==========
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_API_KEY=

# ========== WEBSOCKET (Real-time Updates) ==========
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
WS_ENABLED=true

# ========== PERFORMANCE MONITORING ==========
TRACES_SAMPLE_RATE=0.1
PROFILES_SAMPLE_RATE=0.1
LOG_LEVEL=INFO

# ========== RATE LIMITING ==========
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
