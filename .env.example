# Application
APP_ENV=development
PUBLIC_REGISTRATION_ENABLED=false
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
JWT_ISSUER=opspecta-api
JWT_AUDIENCE=opspecta-app
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_SECRET_KEY=your-refresh-secret-key-change-in-production
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database
DATABASE_URL=postgresql://fpconnect:fpconnect_pass@db:5432/fpconnect
POSTGRES_USER=fpconnect
POSTGRES_PASSWORD=fpconnect_pass
POSTGRES_DB=fpconnect

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO / S3
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=fpconnect

# OpenAI
OPENAI_API_KEY=sk-placeholder-change-me

# API
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=OPSPECTA
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_SITE_URL=https://fpconnect.tec.br
NEXT_PUBLIC_PREVIEW_MODE=false
