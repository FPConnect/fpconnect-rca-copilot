{
  "name": "fpconnect-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "npx expo start --go -c",
    "start:go": "npx expo start --go -c",
    "start:dev-client": "npx expo start --dev-client -c",
    "android": "npx expo start --android",
    "ios": "npx expo start --ios",
    "web": "npx expo start --web",
    "test": "echo 'No tests yet' && exit 0",
    "doctor": "npx expo-doctor",
    "reinstall": "npm run clean && npm cache clean --force && npm install",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('node_modules',{recursive:true,force:true});\"",
    "clean:all": "node -e \"const fs=require('fs');fs.rmSync('node_modules',{recursive:true,force:true});fs.rmSync('package-lock.json',{force:true});\""
  },
  "dependencies": {
    "expo": "~54.0.33",
    "expo-dev-client": "~6.0.0",
    "expo-router": "~6.0.23",
    "expo-status-bar": "~3.0.9",
    "expo-asset": "~12.0.12",
    "expo-linking": "~8.0.11",
    "expo-constants": "~18.0.13",
    "@expo/vector-icons": "^15.0.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-screens": "~4.16.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "react-native-svg": "15.12.1",
    "lucide-react-native": "^0.575.0",
    "react-native-web": "^0.21.0",
    "@react-native-async-storage/async-storage": "~2.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
