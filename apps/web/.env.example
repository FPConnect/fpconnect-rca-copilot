# Frontend Environment Variables
# Copy this file to .env.local and fill in the values

# FastAPI Backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional server-side URL override for validating dashboard sessions via /auth/me.
# Production requires HTTPS. Without a reachable API, dashboard access is denied.
# API_URL=https://your-backend.example

# Account creation stays hidden until a real verification provider is configured.
NEXT_PUBLIC_REGISTRATION_ENABLED=false

# Local demonstration data is opt-in and must remain false in production.
NEXT_PUBLIC_PREVIEW_MODE=false

# App info
NEXT_PUBLIC_APP_VERSION=1.0.0
