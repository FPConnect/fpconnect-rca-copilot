# Frontend Environment Variables
# Copy this file to .env.local and fill in the values

# FastAPI Backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# App info
NEXT_PUBLIC_APP_NAME=FPConnect
NEXT_PUBLIC_APP_VERSION=1.0.0

# Optional: high-quality narration for the institutional demo
OPENAI_API_KEY=
DEMO_NARRATION_MODEL=gpt-4o-mini-tts
DEMO_NARRATION_VOICE=onyx
DEMO_NARRATION_EDGE_VOICE=pt-BR-AntonioNeural

# Optional: prerecorded human narration files can be placed in
# public/narration/demo-institucional/<step-id>.mp3
