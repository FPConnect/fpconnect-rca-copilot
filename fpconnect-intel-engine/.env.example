# Optional (enables bilingual summaries via LLM)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Optional (enables auto-creation of GitHub Issues)
GITHUB_TOKEN=
GITHUB_REPO=your-org/your-repo

# Polling interval (seconds). Default: 900 (15min)
POLL_INTERVAL_SECONDS=900
