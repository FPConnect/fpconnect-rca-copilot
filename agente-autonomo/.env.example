# Copie este arquivo para .env e preencha com suas chaves.
# O script start_web.ps1/.bat carrega automaticamente essas variaveis.

# Modo de backend:
# - auto: tenta os provedores na ordem (OpenAI -> Anthropic -> Gemini)
# - all: consulta todos os provedores configurados e agrega as respostas
# - openai | anthropic | gemini
AGENTE_AUTONOMO_BACKEND=all

# OpenAI (ou endpoint compativel)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# GOOGLE_API_KEY=

# Servidor web
AGENTE_AUTONOMO_HOST=127.0.0.1
PORT=8012

# Base publica usada nos callbacks OAuth e links externos do agente.
# Exemplo: https://agente.seudominio.com
AGENTE_AUTONOMO_PUBLIC_BASE_URL=http://127.0.0.1:8012

# OAuth de cloud drives
# Redirect URI Google Drive:
#   <AGENTE_AUTONOMO_PUBLIC_BASE_URL>/api/cloud/oauth/google/callback
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# Redirect URI OneDrive:
#   <AGENTE_AUTONOMO_PUBLIC_BASE_URL>/api/cloud/oauth/onedrive/callback
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
