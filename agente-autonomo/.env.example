# Copie este arquivo para .env e preencha com suas chaves.
# O script start_web.ps1/.bat carrega automaticamente essas variaveis.

# Modo de backend:
# - auto: tenta os provedores na ordem (OpenAI -> Anthropic -> Gemini)
# - all: consulta todos os provedores configurados e agrega as respostas
# - openai | ollama | anthropic | gemini
AGENTE_AUTONOMO_BACKEND=all

# OpenAI (ou endpoint compativel)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# GOOGLE_API_KEY=

# Porta opcional para os scripts
PORT=8012

# ------------------------------------------------------------
# MODO LOCAL (Ollama + Granite), inspirado no modelo IBM
# ------------------------------------------------------------
# Para usar local-first sem APIs externas:
# 1) instale Ollama (https://ollama.com/download)
# 2) rode:
#    ollama pull granite4:tiny-h
#    ollama pull granite4:350m-h
#    ollama pull granite-embedding:30m
# 3) habilite estas variaveis:
# AGENTE_AUTONOMO_BACKEND=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_API_KEY=ollama
# OLLAMA_MODEL=granite4:tiny-h
#
# Alternativa compativel (sem backend ollama explicito):
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=granite4:tiny-h
